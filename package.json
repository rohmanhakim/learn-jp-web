{
  "name": "learn-jp-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/import-seed.ts",
    "seed:remote": "tsx scripts/import-seed.ts --remote",
    "db:apply": "wrangler d1 migrations apply learn-jp --local",
    "db:apply:remote": "wrangler d1 migrations apply learn-jp --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && wrangler types --check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "wanakana": "5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
